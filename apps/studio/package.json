{
  "name": "studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "validate": "sanity schema validate",
    "seed": "sanity dataset import ../../seed/tems-seed.tar.gz production --missing",
    "seed:replace": "sanity dataset import ../../seed/tems-seed.tar.gz production --replace",
    "backup": "sanity dataset export production ../../backups/tems-production-$(date +%Y-%m-%d).tar.gz",
    "check:seed": "tsx scripts/check-seed.ts"
  },
  "dependencies": {
    "@sanity/vision": "6.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanity": "6.22.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6"
  }
}
