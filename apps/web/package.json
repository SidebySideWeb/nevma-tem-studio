    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.6",
    "astro": "^7.4.8",
    "resend": "^6.37.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "pixelmatch": "^8.0.0",
