---
import { img } from '../../lib/image';
import type { ContactPage } from '../../lib/types';

interface Props {
  page: ContactPage;
}

const { page } = Astro.props;
---
<section class="t-006107" data-block="02-hero">
<img src={img(page.heroImage, 2400)} alt={page.heroImage?.alt ?? ''} class="t-5d49a4" fetchpriority="high">
<div class="t-6d78e4"></div>
<div class="wrap t-d55e32">
<h1 class="d hx t-73df06">{page.title}</h1>
<p class="t-8f7ba1">{page.intro}</p>
</div>
</section>
