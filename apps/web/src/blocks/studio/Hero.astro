---
import { img } from '../../lib/image';
import type { Room, RoomsPage } from '../../lib/types';

interface Props {
  room: Room;
  shared: RoomsPage;
  total: number;
}

const { room, shared, total } = Astro.props;
const label = `Room ${String(room.order).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
const heroSrc = img(room.heroImage, 1600);
const heroSrcSet = [800, 1600, 2400]
  .map((w) => `${img(room.heroImage, w)} ${w}w`)
  .join(', ');
---
<link rel="preload" as="image" href={heroSrc} imagesrcset={heroSrcSet} imagesizes="100vw" fetchpriority="high" />
<section class="t-3b698b" data-block="02-hero">
<img src={heroSrc} srcset={heroSrcSet} sizes="100vw" alt={room.heroImage?.alt ?? ''} class="t-67019f" fetchpriority="high" decoding="async">
<div class="t-f52595"></div>
<div class="wrap t-8b652c">
<span class="m t-5ebfe7">{label}</span>
<h1 class="d hx t-b9142d">{room.name}</h1>
<div class="stack t-cd1383">
<p class="t-cf25d4">{room.heroIntro}</p>
<div class="t-18d4ed">
<a href={`/enquire?room=${room.slug}`} class="m t-982321">{room.askLabel}</a>
<a href="/contact" class="m t-0a1dcd">{shared.contactLabel}</a>
</div>
</div>
</div>
</section>
