---
import FaqList from '../shared/FaqList.astro';
import type { EnquirePage } from '../../lib/types';

interface Props {
  page: EnquirePage;
}

const { page } = Astro.props;
---
<section class="t-45e285" data-block="03-faq">
<div class="wrap stack t-f1f86d">
<div class="t-835ab7">
<h2 class="d hy t-117a6d">{page.faqTitle}</h2>
<p class="t-59c245">{page.faqIntro}</p>
</div>
<FaqList items={page.faqItems ?? []} firstOpen={true} tone="paper" nativeButtons={true} />
</div>
</section>
