---
import { img } from '../../lib/image';
import { lines } from '../../lib/text';
import type { EnquirePage, RoomCard, Settings } from '../../lib/types';
import { ui } from '../../lib/ui';

interface Props {
  page: EnquirePage;
  settings: Settings;
  rooms?: RoomCard[];
  state?: 'form' | 'sent';
  /** From `?room=` on /enquire (SSR only; static pages apply via script). */
  roomSlug?: string | null;
  /** From `?error=1` no-JS failure redirect. */
  showError?: boolean;
}

const CHIP_ON = 't-32a902';
const CHIP_OFF = 't-faaab6';

const {
  page,
  settings,
  rooms = [],
  state = 'form',
  roomSlug = '',
  showError = false,
} = Astro.props;

const labels = page.labels ?? {};
const form = page.form;
const types = form?.projectTypes ?? [];
const defaultType = form?.defaultProjectType || types[0] || '';
const titleLines = lines(page.title);
const room = roomSlug ? rooms.find((r) => r.slug === roomSlug) : undefined;
const messagePlaceholder = room
  ? `Room: ${room.name}\n${labels.messagePlaceholder ?? ''}`
  : (labels.messagePlaceholder ?? '');
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '';
const showForm = state === 'form';
const roomsJson = JSON.stringify(rooms.map((r) => ({ slug: r.slug, name: r.name })));
---
<section class="stack t-3f6ed5" data-block="02-form">
<div class="pad t-ab1297">
<img src={img(page.image, 1600)} alt={page.image?.alt ?? ''} class="t-84e00e" fetchpriority="high">
<div class="t-9dace9">
<div class="m t-fb9057"><span class="t-25f105"></span>{page.label}</div>
<h1 class="d hx t-ed9038">{titleLines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h1>
<p class="t-c74d5b">{page.intro}</p>
</div>
<div class="t-76bbe0">
<div class="t-78e62b"><span class="m t-717e45">{ui.enquire.email}</span><a href={`mailto:${settings.email}`} class="t-52ad68">{settings.emailDisplay}</a></div>
<div class="t-78e62b"><span class="m t-717e45">{ui.enquire.phone}</span><span>{settings.phoneDisplay}</span></div>
<div class="t-78e62b"><span class="m t-717e45">{ui.enquire.replyWithin}</span><span>{settings.replyTime}</span></div>
</div>
</div>

<div class="pad t-71287c" data-enquire-panel>
{showForm ? (
<>
<form
  class="t-4148f1"
  action="/api/enquiry"
  method="post"
  data-enquire-form
  data-error-text={page.errorText ?? ''}
  data-allowed-types={JSON.stringify(types)}
  data-rooms={roomsJson}
  data-message-placeholder={labels.messagePlaceholder ?? ''}
  novalidate
>
<input type="text" name="company" class="sr-only" tabindex={-1} autocomplete="off" aria-hidden="true">
<input type="hidden" name="room" value={roomSlug || ''}>
<div data-project-types>
{defaultType ? <input type="hidden" name="projectTypes" value={defaultType}> : null}
</div>
<div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-size="invisible"></div>

<div class="g2 t-351e81">
<label class="t-355eed"><span class="m">{labels.name}</span><input type="text" name="name" required minlength="2" maxlength="80" autocomplete="name" placeholder={labels.namePlaceholder ?? ''} class="t-4c61f4"></label>
<label class="t-355eed"><span class="m">{labels.artist}</span><input type="text" name="artist" maxlength="80" autocomplete="organization" placeholder={labels.artistPlaceholder ?? ''} class="t-4c61f4"></label>
<label class="t-355eed"><span class="m">{labels.email}</span><input type="email" name="email" required autocomplete="email" placeholder={labels.emailPlaceholder ?? ''} class="t-4c61f4"></label>
<label class="t-355eed"><span class="m">{labels.phone}</span><input type="tel" name="phone" maxlength="30" autocomplete="tel" placeholder={labels.phonePlaceholder ?? ''} class="t-4c61f4"></label>
</div>
<fieldset class="t-6343ed">
<legend class="m t-6ee34a">{labels.projectType}</legend>
<div class="t-e106d6" data-project-chips>
{types.map((type) => {
  const on = type === defaultType;
  return (
<button type="button" aria-pressed={on ? 'true' : 'false'} data-value={type} class={on ? CHIP_ON : CHIP_OFF}>{type}</button>
  );
})}
</div>
</fieldset>
<div class="g2 t-351e81">
<label class="t-355eed"><span class="m">{labels.start}</span><input type="date" name="preferredStart" class="t-4c61f4"></label>
<label class="t-355eed"><span class="m">{labels.days}</span><input type="number" name="days" min="1" max="60" placeholder={labels.daysPlaceholder ?? ''} class="t-4c61f4"></label>
</div>
<label class="t-355eed"><span class="m">{labels.message}</span><textarea name="message" rows="5" maxlength="4000" placeholder={messagePlaceholder} class="t-2bea68"></textarea></label>
<label class="t-bd774c"><input type="checkbox" name="consent" value="true" required class="t-2a1767"><span>{labels.consent} <a href="/legal/privacy" class="t-94e8fd">{labels.privacyLink}</a></span></label>
<p class="enquire-status" role="status" aria-live="polite" data-enquire-error>{showError ? page.errorText : ''}</p>
<div class="t-12cf4d">
<button type="submit" class="m t-c0252b">{labels.submit}</button>
<span class="m t-de6536">{labels.protectedBy}</span>
</div>
</form>
{/* Inactive sent markup in <template> so fidelity styleFingerprint does not see its fonts/colours. */}
<template data-enquire-sent-template>
<div class="t-aa0388" data-enquire-sent>
<span class="d t-c58074" data-enquire-thanks-title>{page.thanksTitle}</span>
<p class="t-bab7a9">{page.thanksText}</p>
<button type="button" class="m t-49e2ce" data-enquire-again>{page.againLabel}</button>
</div>
</template>
</>
) : (
<div class="t-aa0388" data-enquire-sent>
<span class="d t-c58074" data-enquire-thanks-title>{page.thanksTitle}</span>
<p class="t-bab7a9">{page.thanksText}</p>
<button type="button" class="m t-49e2ce" data-enquire-again>{page.againLabel}</button>
</div>
)}
</div>
</section>
<script>
  import { initEnquiry } from '../../scripts/enquiry';
  initEnquiry();
</script>
