---
import FaqList from '../shared/FaqList.astro';
import type { SessionsPage } from '../../lib/types';

interface Props {
  page: SessionsPage;
}

const { page } = Astro.props;
---
<section class="t-5decf6" data-block="05-faq">
<div class="wrap stack t-f1f86d">
<div class="t-835ab7">
<h2 class="d hy t-117a6d">{page.faqTitle}</h2>
<p class="t-fe52ea">{page.faqIntro}</p>
</div>
<FaqList items={page.faqItems ?? []} tone="ink" />
</div>
</section>
