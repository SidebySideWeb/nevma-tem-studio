# Site
PUBLIC_SITE_URL=http://localhost:4321
# Optional HTTP Basic Auth on Vercel (Preview and/or Production). Unset = open.
# Username is ignored; browser prompts for password. Same as Nevma Music / VIP Transfers.
SITE_PASSWORD=

# Sanity (project "TEMS" in the NEVMA organisation)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2025-10-01
# Viewer token: the build reads the private dataset. Never exposed to the browser.
SANITY_VIEWER_TOKEN=
# Editor token: used only by /api/enquiry to create formSubmission documents.
SANITY_WRITE_TOKEN=

# Studio (apps/studio)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_HOST=tems

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM="TEMS <studio@example.com>"

# Cloudflare Turnstile (Invisible widget). Test keys for local/e2e:
# site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Fidelity test
SITE_URL=http://localhost:4321
